{
  "name": "loup-garou-bel-tounsi",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=.sim.mjs --log-level=error && node .sim.mjs",
    "assets": "python3 scripts/build_app_assets.py",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug && echo '→ android/app/build/outputs/apk/debug/app-debug.apk'",
    "apk:release": "npm run sync && cd android && ./gradlew assembleRelease",
    "test:lan": "node scripts/test-lan.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  }
}
