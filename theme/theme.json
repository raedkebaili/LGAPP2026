{
  "name": "ليل الحومة — Lil El 7ouma",
  "description": "Thème de LOUP GAROU BEL TOUNSI. Deux peaux : الليل (nuit, par défaut) et النهار (jour). Inspiration : médina tunisienne la nuit — chaux blanche, portes bleu Sidi Bou Saïd, lanternes en fer forgé, terre cuite, ciel indigo.",
  "version": "1.0",

  "palettes": {
    "night": {
      "bg":          "#0A0D16",
      "bgElevated":  "#111726",
      "surface":     "#161D30",
      "surface2":    "#1D2639",
      "border":      "#27314A",
      "text":        "#EDEAE3",
      "textMuted":   "#9AA0B8",
      "primary":     "#E9B44C",
      "primaryDim":  "#B8842F",
      "accent":      "#D1603D",
      "blue":        "#3E7CB1",
      "success":     "#3FBF82",
      "danger":      "#E0483B",
      "overlay":     "rgba(5,7,14,.72)"
    },
    "day": {
      "bg":          "#F6EFE0",
      "bgElevated":  "#FFFAF0",
      "surface":     "#FFFFFF",
      "surface2":    "#FBF4E6",
      "border":      "#E2D4B8",
      "text":        "#241E14",
      "textMuted":   "#7C6D55",
      "primary":     "#C2881B",
      "primaryDim":  "#9A6A12",
      "accent":      "#BE4A26",
      "blue":        "#2E6FB7",
      "success":     "#2E9A66",
      "danger":      "#C13A2E",
      "overlay":     "rgba(36,30,20,.5)"
    }
  },

  "camps": {
    "village":  { "color": "#3E7CB1", "bg": "#14314D", "text": "#9CCBF5", "emoji": "🏘️" },
    "loups":    { "color": "#D1603D", "bg": "#44190F", "text": "#FFAB87", "emoji": "🐺" },
    "amoureux": { "color": "#E4698F", "bg": "#44131F", "text": "#FFA9C2", "emoji": "💔" },
    "solo":     { "color": "#A96BD9", "bg": "#2E1540", "text": "#DCAAF5", "emoji": "🔥" }
  },

  "typography": {
    "arabicDisplay": { "stack": "'Aref Ruqaa', 'Amiri', 'Scheherazade New', serif", "usage": "titres, nom de l'app, annonces du narrateur" },
    "arabicUi":      { "stack": "'Tajawal', 'Cairo', 'Noto Kufi Arabic', 'Segoe UI', sans-serif", "usage": "interface, boutons, listes" },
    "latin":         { "stack": "'Inter', 'Poppins', system-ui, sans-serif", "usage": "noms de rôles en français, chiffres" },
    "scale": { "display": 40, "h1": 30, "h2": 24, "h3": 20, "body": 17, "small": 15, "tiny": 13 },
    "lineHeight": { "tight": 1.3, "normal": 1.75, "arabic": 1.95 }
  },

  "radii":   { "sm": 8, "md": 14, "lg": 20, "xl": 28, "pill": 999 },
  "spacing": { "xs": 4, "sm": 8, "md": 14, "lg": 22, "xl": 34 },

  "shadows": {
    "card":  "0 6px 24px rgba(0,0,0,.45)",
    "glow":  "0 0 28px rgba(233,180,76,.26)",
    "inset": "inset 0 1px 0 rgba(255,255,255,.05)"
  },

  "motion": { "fast": "140ms", "normal": "260ms", "slow": "520ms", "ease": "cubic-bezier(.22,.9,.3,1)" },

  "motifs": {
    "khatem": "Étoile à 8 branches (خاتم سليمان) — motif de fond, opacité 4 à 8%",
    "zellige": "Trame géométrique de zellige en filigrane sur les en-têtes",
    "lantern": "Halo de lanterne en radial-gradient derrière les titres de phase"
  },

  "phaseSkins": {
    "night": { "label": "الليل", "icon": "🌙", "bodyClass": "phase-night" },
    "day":   { "label": "النهار", "icon": "☀️", "bodyClass": "phase-day" }
  }
}
